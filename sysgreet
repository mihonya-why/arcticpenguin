get_logo "$DISTRO_ID"

W=50
LOGO_W=26
GAP=4

print_line() {
    local label="$1" value="$2"
    local inner=$((W - 4))
    local max_val=$((inner - 10))
    if (( ${#value} > max_val )); then
        value="${value:0:$((max_val - 3))}..."
    fi
    local content
    content="$(printf '%-10s%s' "$label" "$value")"
    local pad=$((inner - ${#content}))
    printf "${C}│${R}  ${C2}%-10s${R}%s" "$label" "$value"
    printf '%*s' "$pad" ""
    printf "${C}│${R}"
}

print_logo_line() {
    local idx="$1"
    if (( idx < ${#LOGO[@]} )); then
        printf "%*s${C}%s${R}" "$GAP" "" "${LOGO[$idx]}"
    fi
}

echo ""

for line in "${BANNER[@]}"; do
    echo -e "  ${C}${line}${R}"
done

echo ""
echo -e "  ${C}  $NOW_TIME${R}"
echo ""

INFOLINES=(
    "PC:|$GREET_HOST"
    "Distro:|$GREET_DISTRO"
    "Kernel:|$GREET_KERNEL"
    "CPU:|$GREET_CPU ($GREET_CORES cores)"
    "RAM:|$GREET_RAM"
    "GPU:|$GREET_GPU"
    "GPU Temp:|$GREET_GPU_TEMP"
    "Packages:|$GREET_PACKAGES"
    "Shell:|$GREET_SHELL"
    "Terminal:|$GREET_TERM"
    "Res:|$GREET_RES"
    "DE:|$GREET_DE"
    "WM:|$GREET_WM"
    "Theme:|$GREET_THEME"
    "Date:|$GREET_DATE"
)

for i in "${!INFOLINES[@]}"; do
    IFS='|' read -r label value <<< "${INFOLINES[$i]}"
    print_line "$label" "$value"
    print_logo_line "$i"
    echo ""
done

for (( i=${#INFOLINES[@]}; i<${#LOGO[@]}; i++ )); do
    printf "%*s" $((W + 2)) ""
    print_logo_line "$i"
    echo ""
done

echo ""
echo -e "  ${C}$(printf '═%.0s' $(seq 1 $W))${R}"
