#!/usr/bin/env bash
# sysgreet — кастомное приветствие для терминала
# Собирает данные о системе в runtime. Портабельный, можно скидывать другим.

NOW_TIME="$(date '+%H:%M')"

if command -v hostname &>/dev/null; then
    GREET_HOST="$(hostname)"
elif [[ -f /etc/hostname ]]; then
    GREET_HOST="$(</etc/hostname)"
else
    GREET_HOST="unknown"
fi

if [[ -f /etc/os-release ]]; then
    . /etc/os-release
    GREET_DISTRO="${PRETTY_NAME:-$NAME}"
    DISTRO_ID="${ID:-unknown}"
else
    GREET_DISTRO="$(uname -o 2>/dev/null || echo 'Unknown OS')"
    DISTRO_ID="unknown"
fi

GREET_KERNEL="$(uname -r)"

GREET_CPU="$(awk -F': ' '/model name/{print $2; exit}' /proc/cpuinfo 2>/dev/null)"
[[ -z "$GREET_CPU" ]] && GREET_CPU="$(uname -m)"

GREET_CORES="$(nproc 2>/dev/null || echo '?')"

read -r MEM_TOTAL MEM_USED MEM_FREE MEM_BUF <<< "$(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{printf "%d %d %d 0", t, t-a, a}' /proc/meminfo 2>/dev/null)"
if [[ -n "$MEM_TOTAL" && "$MEM_TOTAL" -gt 0 ]]; then
    MEM_TOTAL_GB="$(awk "BEGIN{printf \"%.1f\", $MEM_TOTAL/1048576}")"
    MEM_USED_GB="$(awk "BEGIN{printf \"%.1f\", $MEM_USED/1048576}")"
    GREET_RAM="${MEM_USED_GB}G / ${MEM_TOTAL_GB}G"
else
    GREET_RAM="N/A"
fi

GREET_GPU="$(glxinfo 2>/dev/null | grep -oP 'OpenGL renderer string: \K.*' | sed 's/ (.*//')"
if [[ -z "$GREET_GPU" ]]; then
    GREET_GPU="$(vulkaninfo 2>/dev/null | grep -oP 'deviceName\s*=\s*\K.*' | head -1)"
fi
if [[ -z "$GREET_GPU" ]]; then
    GREET_GPU="$(lspci 2>/dev/null | grep -i 'vga\|3d\|display' | head -1 | sed 's/.*: //' | sed 's/ (rev.*//')"
fi
[[ -z "$GREET_GPU" ]] && GREET_GPU="N/A"
(( ${#GREET_GPU} > 45 )) && GREET_GPU="${GREET_GPU:0:42}..."

UPTIME_SEC="$(awk '{print int($1)}' /proc/uptime 2>/dev/null)"
if [[ -n "$UPTIME_SEC" ]]; then
    DAYS=$(( UPTIME_SEC / 86400 ))
    HOURS=$(( (UPTIME_SEC % 86400) / 3600 ))
    MINS=$(( (UPTIME_SEC % 3600) / 60 ))
    GREET_UPTIME=""
    (( DAYS > 0 )) && GREET_UPTIME="${DAYS}d "
    GREET_UPTIME+="${HOURS}h ${MINS}m"
else
    GREET_UPTIME="N/A"
fi

GREET_PACKAGES="$(pacman -Q 2>/dev/null | wc -l)"
[[ "$GREET_PACKAGES" == "0" ]] && GREET_PACKAGES="$(dpkg -l 2>/dev/null | grep '^ii' | wc -l)"
[[ "$GREET_PACKAGES" == "0" ]] && GREET_PACKAGES="$(rpm -qa 2>/dev/null | wc -l)"
[[ "$GREET_PACKAGES" == "0" ]] && GREET_PACKAGES="N/A"
[[ "$GREET_PACKAGES" != "N/A" ]] && GREET_PACKAGES="${GREET_PACKAGES} (pacman)"

GREET_SHELL="${SHELL##*/}"
if [[ -n "$ZSH_VERSION" && "$SHELL" == */zsh ]]; then
    GREET_SHELL="zsh $ZSH_VERSION"
elif [[ -n "$BASH_VERSION" && "$SHELL" == */bash ]]; then
    GREET_SHELL="bash $BASH_VERSION"
fi

GREET_RES="$(xrandr 2>/dev/null | grep -oP '\d+x\d+' | head -1)"
[[ -z "$GREET_RES" ]] && GREET_RES="$(cat /sys/class/drm/card*/status 2>/dev/null | head -1)"
[[ -z "$GREET_RES" ]] && GREET_RES="N/A"

GREET_DE="${XDG_CURRENT_DESKTOP:-$DESKTOP_SESSION}"
[[ -z "$GREET_DE" ]] && GREET_DE="$(ps -eo comm= -C startplasma-x11 2>/dev/null | head -1)"
[[ -z "$GREET_DE" ]] && GREET_DE="$(ps -eo comm= -C gnome-shell 2>/dev/null | head -1)"
[[ -z "$GREET_DE" ]] && GREET_DE="$(ps -eo comm= -C xfce4-session 2>/dev/null | head -1)"
[[ -z "$GREET_DE" ]] && GREET_DE="N/A"

GREET_WM="N/A"
if pgrep -x mutter >/dev/null 2>&1 || pgrep -x gnome-shell >/dev/null 2>&1; then
    GREET_WM="Mutter (GNOME)"
elif [[ -n "$I3SOCK" ]] || ps -eo comm= 2>/dev/null | grep -qi '^i3$'; then
    GREET_WM="i3"
elif pgrep -x hyprland >/dev/null 2>&1; then
    GREET_WM="Hyprland"
elif pgrep -x sway >/dev/null 2>&1; then
    GREET_WM="Sway"
elif pgrep -x bspwm >/dev/null 2>&1; then
    GREET_WM="bspwm"
elif pgrep -x dwm >/dev/null 2>&1; then
    GREET_WM="dwm"
elif pgrep -x openbox >/dev/null 2>&1; then
    GREET_WM="Openbox"
elif pgrep -x kwin >/dev/null 2>&1; then
    GREET_WM="KWin"
elif pgrep -x Marco >/dev/null 2>&1; then
    GREET_WM="Marco"
elif pgrep -x xfwm4 >/dev/null 2>&1; then
    GREET_WM="Xfwm4"
fi

GREET_TERM="${TERM_PROGRAM:-$TERM}"
[[ -n "$KONSOLE_VERSION" ]] && GREET_TERM="Konsole"
[[ -n "$ALACRITTY_SOCKET" || "$TERM" == "alacritty" ]] && GREET_TERM="Alacritty"
[[ "$TERM" == "xterm-kitty" ]] && GREET_TERM="kitty"
[[ -n "$VTE_VERSION" ]] && [[ "$GREET_TERM" == "$TERM" ]] && GREET_TERM="VTE-based"

GREET_THEME="${GTK_THEME:-N/A}"
[[ -z "$GREET_THEME" || "$GREET_THEME" == "N/A" ]] && GREET_THEME="$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'")"
[[ -z "$GREET_THEME" || "$GREET_THEME" == "" ]] && GREET_THEME="N/A"

GREET_GPU_TEMP="$(cat /sys/class/drm/card*/device/hwmon/hwmon*/temp1_input 2>/dev/null | head -1)"
if [[ -n "$GREET_GPU_TEMP" ]]; then
    GREET_GPU_TEMP="$(( GREET_GPU_TEMP / 1000 ))°C"
else
    GREET_GPU_TEMP="N/A"
fi

GREET_DATE="$(date '+%a %d %b %Y')"

C='\033[38;5;141m'
C2='\033[38;5;147m'
